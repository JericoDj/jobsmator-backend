{
  "name": "jobsmator-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "sync:web": "cp src/contracts/index.ts ../jobsmator-web/lib/contracts.ts",
    "industry:backfill": "bun run scripts/backfill-industry.ts"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.1",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.4.0",
    "hono": "^4.13.7",
    "hono-openapi": "^1.3.3",
    "mammoth": "^1.12.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
