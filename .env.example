PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://jobsmator:jobsmator@localhost:5432/jobsmator

# n8n matching engine
N8N_BASE_URL=https://your-n8n-host
N8N_WEBHOOK_SECRET=change-me

# Firebase Admin — base64 of the service-account JSON:  base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Comma-separated allowed browser origins
WEB_ORIGIN=http://localhost:3000
RUNS_PER_HOUR=5
ENGINE_TIMEOUT_MS=120000

# Public base URL of this API (Railway: https://<service>.up.railway.app). OAuth
# redirect URLs are built from it: <API_PUBLIC_URL>/v1/integrations/canva/callback
API_PUBLIC_URL=http://localhost:3001

# Canva Connect API — https://www.canva.com/developers/integrations
# Register the redirect URL above on the integration's Authentication page.
CANVA_CLIENT_ID=OC-xxxxxxxxxxxx
CANVA_CLIENT_SECRET=
CANVA_SCOPES=profile:read design:meta:read design:content:write asset:write
# Deep link the callback sends the user back to once connected
CANVA_APP_RETURN_URL=jobsmator://integrations/canva

# Ask JobsMator (chat + image analysis) — any OpenRouter model with image input.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
AI_MESSAGES_PER_DAY_FREE=30
AI_MESSAGES_PER_DAY_PRO=300
