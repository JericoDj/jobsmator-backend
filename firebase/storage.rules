rules_version = '2';
// Deploy from the Firebase project: `firebase deploy --only storage` with this file as storage.rules.
service firebase.storage {
  match /b/{bucket}/o {
    // Each user owns resumes/{uid}/**. The API reads them via the Admin SDK (bypasses rules).
    match /resumes/{uid}/{file=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
